# ─── Backend API URL ────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# ─── Frontend URL (used for OAuth redirects) ────────────────────────
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ─── Demo Login Credentials ──────────────────────────────────────────
# These auto-fill the login form and submit when a demo button is clicked.
# Leave empty to disable a specific demo role.

NEXT_PUBLIC_DEMO_STUDENT_EMAIL=student@demo.com
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=student123

NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@demo.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123

NEXT_PUBLIC_DEMO_INSTRUCTOR_EMAIL=instructor@demo.com
NEXT_PUBLIC_DEMO_INSTRUCTOR_PASSWORD=instructor123
