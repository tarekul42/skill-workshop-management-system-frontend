# ─── Backend API URL ────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# ─── Frontend URL (used for OAuth redirects) ────────────────────────
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ─── Demo Login Credentials ──────────────────────────────────────────
# Demo credentials are now served from the backend via getDemoCredentials()
# server action. Set DEMO_* env vars on the backend only (NOT NEXT_PUBLIC_*).
# The NEXT_PUBLIC_DEMO_* vars have been removed — they were bundled into
# the client-side JS and posed a security risk.
