    "date-fns": "^4.3.0",
    "framer-motion": "^12.40.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
